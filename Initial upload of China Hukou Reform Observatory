function merc(lat){const r=Math.max(-85,Math.min(85,lat))*Math.PI/180;return Math.log(Math.tan(Math.PI/4+r/2))}
function projection(point){const lon=point[0],lat=point[1],x=34+(lon-73)*12.05,y=22+(merc(54.5)-merc(lat))/(merc(54.5)-merc(16.8))*482;return [Number(x.toFixed(2)),Number(y.toFixed(2))]}
function ringPath(ring){return ring.map((coord,i)=>{const [x,y]=projection(coord);return`${i?'L':'M'}${x} ${y}`}).join('')+'Z'}
function featurePath(feature){let g=feature.geometry;if(!g||!g.coordinates)return'';if(g.type==='Polygon')return g.coordinates.map(ringPath).join('');if(g.type==='MultiPolygon')return g.coordinates.flatMap(poly=>poly.map(ringPath)).join('');return''}
