 const rows=all.map(p=>{const cs=state.cities.filter(c=>c.province_code===p.code && c.priority==='Primary' || c.province_code===p.code && c.priority==='Comparative');const docs=localDocs(p.code,'all',2026).length;return `<tr><td><strong>${escapeHtml(p.name)}</strong><span class="province-name-zh">${escapeHtml(p.name_zh)}</span></td><td>${escapeHtml(p.region)}<span class="province-name-zh">${escapeHtml(p.type)}</span></td><td>${escapeHtml(cs.find(c=>c.priority==='Primary')?.name || p.capital)}</td><td>${escapeHtml(cs.find(c=>c.priority==='Comparative')?.name || '—')}</td><td><span class="coverage-count ${docs?'present':''}">${docs?docs+' indexed':'Awaiting source'}</span></td><td><button type="button" class="coverage-open" data-coverage="${p.code}">Explore ↗</button></td></tr>`});
